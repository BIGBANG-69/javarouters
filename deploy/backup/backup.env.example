# /opt/javarouters/backup.env — chmod 600, owned by ubuntu. Never commit the real file.
#
# Cloudflare dashboard > R2 Object Storage:
#   1. Create a private bucket (for example javarouters-backup).
#   2. Manage API tokens > Create API token: permission "Object Read & Write",
#      applied to that bucket only. Copy the Access Key ID and Secret Access Key.
#   3. The Account ID is in the S3 endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=javarouters-backup
R2_PREFIX=javarouters

# Generated once on the server: openssl rand -base64 32 > /opt/javarouters/backup.key
# Keep a copy outside the server (password manager). Without it the backups cannot be decrypted.
BACKUP_PASSPHRASE_FILE=/opt/javarouters/backup.key

RETENTION_DAYS=30

# Optional: URL pinged after each successful backup (for example a healthchecks.io check),
# so a missed backup raises an alert.
BACKUP_PING_URL=
