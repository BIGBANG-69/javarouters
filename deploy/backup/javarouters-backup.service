[Unit]
Description=Encrypted JavaRouters database and config backup to Cloudflare R2
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/javarouters
ExecStart=/bin/bash /opt/javarouters/backup.sh backup
TimeoutStartSec=1800
NoNewPrivileges=true
